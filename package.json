{
  "name": "nexo-bot",
  "version": "0.1.0",
  "description": "Bot de Discord multi-servidor para comunidades",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dashboard": "node dashboard/server.js",
    "dashboard:dev": "node --watch dashboard/server.js",
    "deploy": "node src/deploy-commands.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.7",
    "@supabase/supabase-js": "^2.45.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "youtube-dl-exec": "^3.1.13"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
