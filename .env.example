# Discord app propia de este proyecto (NO reusar la de gNoX)
DISCORD_TOKEN=
CLIENT_ID=

# Servidor de test (para deploy rápido de comandos mientras se desarrolla)
GUILD_ID_DEV=

# Supabase — proyecto nuevo, separado del de gNoX
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard web (dashboard/server.js) — servicio propio, separado del bot. Usa el mismo
# DISCORD_TOKEN/CLIENT_ID/SUPABASE_* de arriba, más estos:
CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_BASE_URL=
# PORT lo pone Railway solo; en local por defecto es 3000.

# Sistema de música (src/utils/musicSource.js) — SOLO configurar esto en Railway, no en
# local. Fuerza a youtube-dl-exec a descargar el binario standalone de yt-dlp (no
# depende de python3 del sistema) en vez del .pyz liviano que sí lo necesita. En Windows
# (dev local) no hace falta: el resolver ya baja yt-dlp.exe standalone por defecto.
YOUTUBE_DL_FILENAME=yt-dlp_linux

# Soporte de enlaces de Spotify en /play (src/utils/spotifyResolver.js) — OPCIONALES: si
# faltan, el resto del bot (incluido YouTube en /play) sigue funcionando igual, un link
# de Spotify simplemente muestra "Spotify no está configurado". Se crean en
# developer.spotify.com. Nota: apps nuevas registradas ahí requieren que el dueño tenga
# Spotify Premium activo (política de Spotify desde 2026-02, no depende de este proyecto).
#
# IMPORTANTE: van en las Variables de LOS DOS servicios de Railway (bot Y dashboard) —
# son procesos separados con env vars separadas. El bot los usa para Client Credentials
# Flow (alcanza para tracks sueltos); el dashboard los necesita además para el flujo real
# de autorización (dashboard/spotifyAuth.js, rutas /spotify/authorize y /spotify/callback
# — el único camino que puede listar el contenido de una playlist, ver schema.sql tabla
# spotify_auth). El Redirect URI que se registra en developer.spotify.com tiene que
# apuntar exactamente a "<DASHBOARD_BASE_URL>/spotify/callback".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
