# Discord app propia de este proyecto (NO reusar la de gNoX)
DISCORD_TOKEN=
CLIENT_ID=

# Servidor de test (para deploy rápido de comandos mientras se desarrolla)
GUILD_ID_DEV=

# Supabase — proyecto nuevo, separado del de gNoX
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canal (en un servidor propio, no de un cliente) donde el bot manda alertas de fallas
# reales — ver src/utils/errorReporter.js. Opcional: sin esto, las alertas simplemente
# no se mandan (el bot arranca igual).
OPERATOR_ALERT_CHANNEL_ID=

# Dónde puede un cliente pedir ayuda (link de invite a un server de soporte, canal
# público, email) — se muestra en /help y en el dashboard SOLO si esto está completo.
# Opcional, pero hay que llenarlo con un valor real antes de vender: no se inventa acá.
SUPPORT_CONTACT=

# Dashboard web (dashboard/server.js) — servicio propio, separado del bot. Usa el mismo
# DISCORD_TOKEN/CLIENT_ID/SUPABASE_* de arriba, más estos:
CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_BASE_URL=
# PORT lo pone Railway solo; en local por defecto es 3000.

# DASHBOARD_BASE_URL también la lee el BOT (src/config.js, opcional) — si está seteada
# en el servicio del bot, /setup le muestra el link al dashboard al admin al terminar la
# configuración (Fase 4C-1, onboarding). Sin esto, /setup simplemente no menciona el
# dashboard: nunca inventa una URL.
