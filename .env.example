# Discord app propia de este proyecto (NO reusar la de gNoX)
DISCORD_TOKEN=
CLIENT_ID=

# Servidor de test (para deploy rápido de comandos mientras se desarrolla)
GUILD_ID_DEV=

# Supabase — proyecto nuevo, separado del de gNoX
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard web (dashboard/server.js) — servicio propio, separado del bot. Usa el mismo
# DISCORD_TOKEN/CLIENT_ID/SUPABASE_* de arriba, más estos:
CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_BASE_URL=
# PORT lo pone Railway solo; en local por defecto es 3000.

# Sistema de música (src/utils/musicSource.js) — SOLO configurar esto en Railway, no en
# local. Fuerza a youtube-dl-exec a descargar el binario standalone de yt-dlp (no
# depende de python3 del sistema) en vez del .pyz liviano que sí lo necesita. En Windows
# (dev local) no hace falta: el resolver ya baja yt-dlp.exe standalone por defecto.
YOUTUBE_DL_FILENAME=yt-dlp_linux
